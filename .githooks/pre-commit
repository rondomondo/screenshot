#!/usr/bin/env bash
# pre-commit: sensitive variable scanner
# Cross-platform: uses python3 for regex (no GNU grep required)

set -euo pipefail

DIFF=$(git diff --cached --unified=0)
FOUND=0

check_pattern() {
  local desc="$1"
  local pattern="$2"
  local matches
  matches=$(echo "$DIFF" | python3 -c "
import sys, re

text = sys.stdin.read()
line_num = 0
current_file = '(unknown)'
results = []

for line in text.splitlines():
    file_match = re.match(r'^\+\+\+ b/(.+)', line)
    if file_match:
        current_file = file_match.group(1)
        continue
    hunk = re.match(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@', line)
    if hunk:
        line_num = int(hunk.group(1)) - 1
        continue
    if line.startswith('+') and not line.startswith('+++'):
        line_num += 1
        m = re.search(r'''$pattern''', line[1:], re.IGNORECASE)
        if m:
            results.append(f'{current_file}:{line_num}: {m.group(0)}')
    elif not line.startswith('-'):
        line_num += 1

print('\n'.join(results))
" 2>/dev/null)
  if [ -n "$matches" ]; then
    echo "  [!] Possible $desc:"
    echo "$matches" | while IFS= read -r match; do
      echo "      $match"
    done
    FOUND=1
  fi
}

check_pattern "AWS access key"               'AKIA[0-9A-Z]{16}'
check_pattern "GitHub PAT or app token"      'gh[pousr]_[A-Za-z0-9_]{36,255}'
check_pattern "Generic credential assignment" '(password|passwd|secret|api_key|apikey|auth_token)\s*[=:]\s*.{6,}'
check_pattern "PEM private key block"        '-----BEGIN (RSA|EC|OPENSSH|PGP) PRIVATE KEY-----'
check_pattern "Database URI with creds"      '(postgres|mysql|mongodb)://\S{8,}'

if [ "$FOUND" -eq 1 ]; then
  echo ""
  echo "pre-commit: sensitive value detected in staged changes."
  echo "Review the matches above before committing."
  echo ""
  echo "  To bypass: git commit --no-verify"
  echo ""
  exit 1
fi


