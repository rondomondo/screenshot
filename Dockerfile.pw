# Stage 1: npm deps on top of the official Playwright image
# mcr.microsoft.com/playwright ships with Chromium, Firefox, WebKit + all their deps pre-installed.
# Pin to a specific version tag matching your playwright-chromium package version for reproducibility.
# Check available tags at: https://mcr.microsoft.com/v2/playwright/tags/list
FROM mcr.microsoft.com/playwright:v1.50.0-noble AS npm-deps

WORKDIR /app
COPY package.json package-lock.json* ./
# Bundled browsers are already present in the base image; skip re-download
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN npm ci --omit=dev || npm install @duckduckgo/autoconsent

# Stage 2: final runtime image
FROM npm-deps AS runtime

# imagemagick for `convert` post-processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    imagemagick \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/root
ENV SHELL=/bin/bash

COPY .bashrc /root/.bashrc
COPY .bash_aliases /root/.bash_aliases
COPY entrypoint.sh /entrypoint.sh
COPY install.sh /install.sh
COPY uninstall.sh /uninstall.sh
COPY url2capture.sh /usr/local/lib/screenshot/url2capture.sh
RUN chmod +x /entrypoint.sh /install.sh /uninstall.sh \
    /usr/local/lib/screenshot/url2capture.sh

VOLUME ["/screenshots", "/pdfs", "/html"]
ENTRYPOINT ["/entrypoint.sh"]
