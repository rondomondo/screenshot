# find4 pipeline image -- python:3.12-slim + uv + Node (for Playwright screenshots)
#
# Includes: git, make, python3 (uv), curl, zsh, sudo, and common CLI utilities.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.7.13 /uv /uvx /usr/local/bin/
COPY --from=mikefarah/yq:4 /usr/bin/yq /usr/local/bin/yq

ARG DEBIAN_FRONTEND=noninteractive

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        make git curl wget unzip sudo jq \
        zsh procps less htop lsof \
        libmagic1 libmagic-dev \
        ca-certificates gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
       > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 find4 && \
    useradd  --uid 1000 --gid 1000 -m -s /bin/bash find4 && \
    echo "find4 ALL=(ALL:ALL) NOPASSWD: ALL" > /etc/sudoers.d/find4 && \
    chmod 0440 /etc/sudoers.d/find4 && \
    mkdir -p /workspace && \
    chown -R find4:find4 /workspace

COPY --chown=root:root entrypoint.sh  /entrypoint.sh
COPY --chown=root:root install.sh    /install.sh
COPY --chown=root:root uninstall.sh  /uninstall.sh
COPY --chown=root:root run.sh        /usr/local/bin/find4-run
COPY --chown=root:root find4         /usr/local/lib/find4/scripts/find4
COPY --chown=root:root scripts/      /usr/local/lib/find4/scripts/
ENV FIND4_SCRIPTS=/usr/local/lib/find4/scripts
COPY --chown=root:root references/      /usr/local/lib/find4/references/
RUN chmod +x /entrypoint.sh /install.sh /uninstall.sh /usr/local/bin/find4-run \
    /usr/local/lib/find4/scripts/find4 \
    /usr/local/lib/find4/scripts/padm

USER find4

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
